# Copy this file to ".env" (same folder) and fill in YOUR values.
# The real ".env" file must NEVER be uploaded to GitHub (it is listed in .gitignore).

# Secret used to sign login cookies. Use a long random text (at least 32 characters).
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab_freelance
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# 1 = development mode (shows the fake mailbox at /dev/mailbox, auto-reload, debug pages)
# 0 = anything else. Never use 1 on a real server.
DEV_MODE=1

# How long a password-reset link stays valid (minutes)
RESET_LINK_MINUTES=30
